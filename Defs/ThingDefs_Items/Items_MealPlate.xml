  </ThingDef>
  <JobDef><defName>AMJA_TakeMeal</defName><driverClass>AMJAgriculture.Dining.TakeMealJob</driverClass><reportString>Serving a meal.</reportString><casualInterruptible>true</casualInterruptible></JobDef>
